{
  "id": "anibt",
  "name": "AniBT (番组字幕发布)",
  "description": "AniBT 字幕组发布平台 — 通过公开 API 搜索番剧磁力链接，支持中文标题搜索、按集/分辨率过滤。自动提取本季度最新发布。",
  "version": "1.3.0",
  "author": "Elisoar",
  "type": "anime-torrent-provider",
  "language": "javascript",
  "lang": "zh",
  "icon": "https://raw.githubusercontent.com/Elisoar111/seanime-extensions/main/anibt/icon.png",
  "payloadURI": "https://raw.githubusercontent.com/Elisoar111/seanime-extensions/main/anibt/provider.js",
  "manifestURI": "https://raw.githubusercontent.com/Elisoar111/seanime-extensions/main/anibt/manifest.json",
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "apiUrl",
        "label": "API 地址",
        "type": "text",
        "default": "https://anibt.net",
        "description": "站点地址，一般不需要修改"
      }
    ]
  }
}